    challenges:
        - name: "Glory PB"
          teamSize: 1
          description: "Complete the Fortis Colosseum with as much glory as possible!"
          type: "Points"
        - name: "Deepest Delve"
          teamSize: 1
          description: "Reach the deepest delve level you can at the Doom of Mokhaiotl!"
          type: "Points"
        - name: "Trio Hueycoatl Speedrun"
          teamSize: 3
          description: "Kill the Hueycoatl as quickly as possible in a group of three! All players must be on your team."
          type: "Speedrun"
        - name: "Corrupted Gauntlet Speedrun"
          teamSize: 1
          description: "Complete the Corrupted Gauntlet as quickly as possible!"
          type: "Speedrun"
    records:
        - name: "Mining (No charged celestial ring)"
          description: "Get as much mining XP as you can in 6 hours! The charged celestial ring is not allowed."
        - name: "Sailing (Trials only)"
          description: "Get as much sailing XP as you can in 6 hours, ONLY completing Barracuda Trials!"
        - name: "Hunter (Red chins only, no horn of plenty)"
          description: "Get as much hunter XP as you can in 6 hours, ONLY catching red chinchompas! The horn of plenty is not allowed."
        - name: "Woodcutting"
          description: "Get as much woodcutting XP as you can in 6 hours!"
